# Copy to .env and fill in. Never commit .env.

# Demo bearer token required on /api routes (any long random string).
DEMO_TOKEN=change-me-to-a-long-random-string

# API port (the Vite dev server proxies /api and /health to it).
PORT=3001

# SQLite file path for the persistent store (used from Phase 1).
DATABASE_PATH=./trustdesk.db

# Folder with the seed data (customers.json, tickets.json, knowledge_base/, ...). Used by npm run seed.
DATA_DIR=../data

# AI provider: "mock" (tests and reproducible baseline) or "groq" (live).
AI_PROVIDER=mock

# Groq (required only when AI_PROVIDER=groq). Server-side only; never sent to the client.
GROQ_API_KEY=KEY
# Confirm the model ID against Groq's current model list (GET /openai/v1/models). Example: openai/gpt-oss-20b (faster, less reliable on safety escalation).
GROQ_MODEL=openai/gpt-oss-120b
